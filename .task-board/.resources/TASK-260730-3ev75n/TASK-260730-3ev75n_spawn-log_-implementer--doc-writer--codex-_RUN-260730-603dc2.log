            configurationProvider: any Swipe2Cash.Data.API.IBackendConfigurationProvider,
            authorizationProvider: any Swipe2Cash.Data.API.IAuthorizationProvider,
            decoder: JSONDecoder = JSONDecoder()
        ) {
            self.client = client
            self.configurationProvider = configurationProvider
            self.authorizationProvider = authorizationProvider
            self.decoder = decoder
        }

        public func accountBalance() async throws -> Swipe2Cash.Business.Model.MoneyAmount {
            let url = configurationProvider.swipe2CashBackendBaseURL.appendingPathComponent("account/balance")
            let endpoint = ApiEndpoint(path: url.absoluteString, type: .get)
            let response = try await perform(endpoint: endpoint)
            guard let data = response.data else {
                throw Swipe2Cash.Err.missingResponseData
            }

            return try decoder
                .decode(Swipe2Cash.Finance.Data.API.Model.AccountBalanceResponse.self, from: data)
                .businessModel
        }
    }
}

private extension Swipe2Cash.Finance.Data.API.AccountBalanceFetcher {
    func perform(endpoint: ApiEndpoint) async throws -> ApiResponse {
        var headers: Headers = [
            .authorization: .bearer(token: try await authorizationProvider.swipe2CashOpenIDToken())
        ]
        headers[.accept] = .applicationJson

        let result = await client.performAsync(
            endpoint: endpoint,
            headers: headers,
            queryParams: [:],
            bodyData: nil,
            fileID: #fileID,
            functionName: #function,
            lineNumber: #line
        )

        switch result {
        case let .success(response):
            guard response.code.isSuccess else {
                throw Swipe2Cash.Err.transport(statusCode: response.code, message: "HTTP \(response.code)")
            }
            return response
        case let .failure(error):
            throw Swipe2Cash.Err.transport(statusCode: error.responseCode, message: error.conciseDescription)
        }
    }
}

