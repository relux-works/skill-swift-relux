public extension Swipe2Cash.Data.API {
    actor TransferFetcher: ITransferFetcher {
        private let client: any IRpcAsyncClient
        private let configurationProvider: any IBackendConfigurationProvider
        private let authorizationProvider: any IAuthorizationProvider
        private let encoder: JSONEncoder
        private let decoder: JSONDecoder
        private let confirmationResponseDelay: Duration

        public init(
            client: any IRpcAsyncClient,
            configurationProvider: any IBackendConfigurationProvider,
            authorizationProvider: any IAuthorizationProvider,
            encoder: JSONEncoder = JSONEncoder(),
            decoder: JSONDecoder = JSONDecoder(),
            confirmationResponseDelay: Duration = .seconds(2)
        ) {
            self.client = client
            self.configurationProvider = configurationProvider
            self.authorizationProvider = authorizationProvider
            self.encoder = encoder
            self.decoder = decoder
            self.confirmationResponseDelay = confirmationResponseDelay
        }

        public func initiateTransfer(
            _ request: Swipe2Cash.Business.Model.TransferRequest,
            identity: Swipe2Cash.Business.Model.Identity
        ) async throws -> Swipe2Cash.Business.Model.Transfer {
            let url = configurationProvider.swipe2CashBackendBaseURL.appendingPathComponent("transfers")
            let endpoint = ApiEndpoint(path: url.absoluteString, type: .post)
            let body = try encoder.encode(
                Swipe2Cash.Data.API.Model.InitiateTransferRequest(
                    request,
                    identity: identity
                )
            )
            let response = try await perform(endpoint: endpoint, body: body)
            return try decodeTransfer(response)
        }

        public func transferStatus(id: String) async throws -> Swipe2Cash.Business.Model.Transfer {
            let url = configurationProvider.swipe2CashBackendBaseURL
                .appendingPathComponent("transfers")
                .appendingPathComponent(id)
            let endpoint = ApiEndpoint(path: url.absoluteString, type: .get)
            let response = try await perform(endpoint: endpoint, body: nil)
            return try decodeTransfer(response)
        }

        public func confirmTransfer(
            id: String,
            otp: String
        ) async throws -> Swipe2Cash.Business.Model.Transfer {
            let url = configurationProvider.swipe2CashBackendBaseURL
                .appendingPathComponent("transfers")
                .appendingPathComponent(id)
                .appendingPathComponent("confirm")
            let endpoint = ApiEndpoint(path: url.absoluteString, type: .post)
            let body = try encoder.encode(Swipe2Cash.Data.API.Model.ConfirmTransferRequest(otp: otp))
            let response = try await perform(endpoint: endpoint, body: body)
            if confirmationResponseDelay > .zero {
                try await Task.sleep(for: confirmationResponseDelay)
            }
            return try decodeTransfer(response)
        }
    }
}

private extension Swipe2Cash.Data.API.TransferFetcher {
    func decodeTransfer(_ response: ApiResponse) throws -> Swipe2Cash.Business.Model.Transfer {
        guard let data = response.data else {
            throw Swipe2Cash.Err.missingResponseData
        }

        return try decoder
            .decode(Swipe2Cash.Data.API.Model.TransferResponse.self, from: data)
