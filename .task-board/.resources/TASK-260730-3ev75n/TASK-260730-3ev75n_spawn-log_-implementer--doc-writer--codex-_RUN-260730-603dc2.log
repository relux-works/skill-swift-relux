    protocol ITransferService: Sendable {
        func initiateTransfer(
            _ request: Swipe2Cash.Business.Model.TransferRequest
        ) async -> Result<Swipe2Cash.Business.Model.Transfer, Swipe2Cash.Err>

        func transferStatus(
            id: String
        ) async -> Result<Swipe2Cash.Business.Model.Transfer, Swipe2Cash.Err>

        func confirmTransfer(
            id: String,
            otp: String
        ) async -> Result<Swipe2Cash.Business.Model.Transfer, Swipe2Cash.Err>
    }

    actor TransferService: ITransferService {
        private let fetcher: any Swipe2Cash.Data.API.ITransferFetcher
        private let identityProvider: any IIdentityProvider

        public init(
            fetcher: any Swipe2Cash.Data.API.ITransferFetcher,
            identityProvider: any IIdentityProvider
        ) {
            self.fetcher = fetcher
            self.identityProvider = identityProvider
        }

        public func initiateTransfer(
            _ request: Swipe2Cash.Business.Model.TransferRequest
        ) async -> Result<Swipe2Cash.Business.Model.Transfer, Swipe2Cash.Err> {
            do {
                let identity = try await identityProvider.swipe2CashIdentity()
                let transfer = try await fetcher.initiateTransfer(request, identity: identity)
                return .success(transfer)
            } catch let error as Swipe2Cash.Err {
                return .failure(error)
            } catch {
                return .failure(.initiateTransferFailed(String(describing: error)))
            }
        }

        public func transferStatus(
            id: String
        ) async -> Result<Swipe2Cash.Business.Model.Transfer, Swipe2Cash.Err> {
            do {
                return .success(try await fetcher.transferStatus(id: id))
            } catch let error as Swipe2Cash.Err {
                return .failure(error)
            } catch {
                return .failure(.fetchTransferStatusFailed(String(describing: error)))
            }
        }

        public func confirmTransfer(
            id: String,
            otp: String
        ) async -> Result<Swipe2Cash.Business.Model.Transfer, Swipe2Cash.Err> {
            do {
                return .success(try await fetcher.confirmTransfer(id: id, otp: otp))
            } catch let error as Swipe2Cash.Err {
                return .failure(error)
            } catch {
                return .failure(.confirmTransferFailed(String(describing: error)))
            }
        }
    }
