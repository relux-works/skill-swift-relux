import Foundation

public extension Swipe2Cash.MoneyTransfer.Business {
    struct CommandService: ICommandService {
        private let commandChannel: any XPAirDrop.Commanding.Business.ICommandChannel
        private let sessionManager: any ISessionManager
        private let systemCodec: XPAirDrop.Commanding.Business.CommandCodec
        private let moneyTransferCodec: Swipe2Cash.MoneyTransfer.Data.Transport.CommandCodec

        public init(
            commandChannel: any XPAirDrop.Commanding.Business.ICommandChannel =
                XPAirDrop.Commanding.Business.CommandChannel(
                    commandTransport: XPAirDrop.Commanding.Business.NoopCommandTransport()
                ),
            sessionManager: any ISessionManager = SessionManager(),
            systemCodec: XPAirDrop.Commanding.Business.CommandCodec = .init(),
            moneyTransferCodec: Swipe2Cash.MoneyTransfer.Data.Transport.CommandCodec = .init()
        ) {
            self.commandChannel = commandChannel
            self.sessionManager = sessionManager
            self.systemCodec = systemCodec
            self.moneyTransferCodec = moneyTransferCodec
        }

        public func commandEvents() -> AsyncStream<Model.CommandEvent> {
            let events = commandChannel.events()
            let sessionManager = sessionManager
            let systemCodec = systemCodec
            let moneyTransferCodec = moneyTransferCodec

            return AsyncStream { continuation in
                Task {
                    for await event in events {
                        await Self.clearSessionManager(
                            sessionManager,
                            from: event
                        )
                        continuation.yield(Self.commandEvent(
                            from: event,
                            systemCodec: systemCodec,
                            moneyTransferCodec: moneyTransferCodec
                        ))
                    }

                    continuation.finish()
                }
            }
        }

        public func setMoneyTransferResponseHandler(
            _ handler: (@concurrent @Sendable (
                Model.Command,
                XPAirDrop.Commanding.Business.Model.WireEnvelope
            ) async -> Model.Command?)?
        ) async {
            let moneyTransferCodec = moneyTransferCodec
            await commandChannel.setCommandResponder { envelope in
                guard let handler,
                      envelope.namespace == moneyTransferCodec.namespace
                else { return nil }

                let command: Model.Command
                do {
                    command = try moneyTransferCodec.decodeCommand(envelope)
                } catch {
                    return nil
                }

                guard let responseCommand = await handler(command, envelope) else {
                    return nil
                }

                let context = Swipe2Cash.MoneyTransfer.Data.Transport.EnvelopeContext.reply(
                    to: envelope,
                    delivery: .fireAndForget
                )
                do {
                    return try moneyTransferCodec.makeEnvelope(responseCommand, context: context)
                } catch {
                    return nil
                }
            }
        }

        public func activateSession(_ session: XPAirDrop.Commanding.Business.Model.Session) async {
            await sessionManager.setCurrentSession(session)
        }

        public func startOutgoingSession(with peer: XPAirDrop.Nearby.Business.Model.Peer) async throws {
            let session = try await commandChannel.startOutgoingSession(with: peer)
            await sessionManager.setCurrentSession(session)
        }

        public func replaceOutgoingSession(
            with peer: XPAirDrop.Nearby.Business.Model.Peer,
            reason: String?,
            withAcknowledgement: Bool
        ) async throws {
            let currentSessionID = await sessionManager.currentSession()?.id
            let session = try await commandChannel.replaceOutgoingSession(
                with: peer,
                closing: currentSessionID,
                reason: reason,
                withAcknowledgement: withAcknowledgement
            )
            await sessionManager.setCurrentSession(session)
        }

        public func acceptIncomingSessions() async throws {
            try await commandChannel.acceptIncomingSessions()
        }

        public func sendMoneyTransfer(
            _ command: Model.Command,
            direction: XPAirDrop.Commanding.Business.Model.Direction,
            delivery: XPAirDrop.Commanding.Business.Model.Delivery
        ) async throws {
            let context = try await sessionManager.makeEnvelopeContext(
                direction: direction,
                delivery: delivery
            )
            let envelope = try moneyTransferCodec.makeEnvelope(command, context: context)
            try await commandChannel.send(envelope)
        }

        public func stopCurrentSession(reason: String?) async {
            guard let session = await sessionManager.currentSession() else {
                await commandChannel.cancelPendingSessions()
                return
            }

            do {
                try await commandChannel.closeSession(session.id, reason: reason)
            } catch {
                await sessionManager.clearCurrentSession(id: session.id)
            }
            await commandChannel.cancelPendingSessions()
        }

        public func discardCurrentSession() async {
            guard let session = await sessionManager.currentSession() else {
                await commandChannel.cancelPendingSessions()
                return
            }

            do {
                try await commandChannel.closeSession(
                    session.id,
                    reason: nil,
                    withAcknowledgement: false
                )
            } catch {
                await sessionManager.clearCurrentSession(id: session.id)
            }
            await commandChannel.cancelPendingSessions()
        }

        public func cancelPendingSessions() async {
            await commandChannel.cancelPendingSessions()
        }

        private static func clearSessionManager(
            _ sessionManager: any ISessionManager,
            from event: XPAirDrop.Commanding.Business.Model.ChannelEvent
        ) async {
            switch event {
                case .incomingPairingStarted:
                    break
                case .sessionEstablishing,
                     .sessionEstablished,
                     .sessionReady:
                    break
                case let .closed(sessionID):
                    await sessionManager.clearCurrentSession(id: sessionID)
                case let .interrupted(interruption):
                    await sessionManager.clearCurrentSession(id: interruption.sessionID)
                case .commandSent,
                     .command,
                     .transportMetric(_),
                     .failure:
                    break
            }
        }

        private static func commandEvent(
            from event: XPAirDrop.Commanding.Business.Model.ChannelEvent,
            systemCodec: XPAirDrop.Commanding.Business.CommandCodec,
            moneyTransferCodec: Swipe2Cash.MoneyTransfer.Data.Transport.CommandCodec
        ) -> Model.CommandEvent {
            switch event {
                case .incomingPairingStarted:
                    return .transport(.incomingPairingStarted)
                case let .sessionEstablishing(session):
                    return .transport(.sessionEstablishing(session))
                case let .sessionEstablished(session):
                    return .transport(.sessionEstablished(session))
                case let .sessionReady(session):
                    return .transport(.sessionReady(session))
                case let .commandSent(envelope):
                    return decodeSentCommandEvent(
                        envelope,
                        systemCodec: systemCodec
                    )
                case let .command(envelope):
                    return decodeCommandEvent(
                        envelope,
                        systemCodec: systemCodec,
                        moneyTransferCodec: moneyTransferCodec
                    )
                case let .transportMetric(metric):
                    return .transport(.metric(metric))
                case let .closed(sessionID):
                    return .transport(.closed(sessionID))
                case let .interrupted(interruption):
                    return .transport(.interrupted(interruption))
                case let .failure(error):
                    return .failure(.init(message: error.description))
            }
        }

        private static func decodeSentCommandEvent(
            _ envelope: XPAirDrop.Commanding.Business.Model.WireEnvelope,
            systemCodec: XPAirDrop.Commanding.Business.CommandCodec
        ) -> Model.CommandEvent {
            if envelope.namespace == .system {
                do {
                    return try .transport(.sent(envelope, system: systemCodec.decodeSystem(envelope)))
                } catch {
                    return .failure(.init(message: error.localizedDescription))
                }
            }

            return .transport(.sent(envelope, system: nil))
        }

        private static func decodeCommandEvent(
            _ envelope: XPAirDrop.Commanding.Business.Model.WireEnvelope,
            systemCodec: XPAirDrop.Commanding.Business.CommandCodec,
            moneyTransferCodec: Swipe2Cash.MoneyTransfer.Data.Transport.CommandCodec
        ) -> Model.CommandEvent {
            do {
                if envelope.namespace == .system {
                    return try .transport(.system(systemCodec.decodeSystem(envelope), envelope: envelope))
                }

                if envelope.namespace == moneyTransferCodec.namespace {
                    return try .moneyTransfer(
                        moneyTransferCodec.decodeCommand(envelope),
                        envelope: envelope
                    )
                }

                return .failure(.init(message: "Unsupported command namespace: \(envelope.namespace.rawValue)"))
            } catch {
                return .failure(.init(message: error.localizedDescription))
            }
        }
    }
}
import Darwin
import ReluxAnalytics
import UIKit

extension S2CDemo {
    enum AnalyticsSupport {}
}

extension S2CDemo.AnalyticsSupport {
    struct DeviceContextProvider: Analytics.ContextProvider {
        func parameters() async -> Analytics.Parameters {
            let osVersion = await MainActor.run {
                UIDevice.current.systemVersion
            }

            return [
                "local_platform": .string("ios"),
                "os_version": .string(osVersion),
                "device_model": .string(Self.deviceModelIdentifier)
            ]
        }
    }
}

private extension S2CDemo.AnalyticsSupport.DeviceContextProvider {
    static var deviceModelIdentifier: String {
        var systemInfo = utsname()
        uname(&systemInfo)

        return Mirror(reflecting: systemInfo.machine).children.reduce(into: "") { result, element in
            guard let value = element.value as? Int8, value != 0 else { return }
            result.append(Character(UnicodeScalar(UInt8(value))))
        }
    }
}

