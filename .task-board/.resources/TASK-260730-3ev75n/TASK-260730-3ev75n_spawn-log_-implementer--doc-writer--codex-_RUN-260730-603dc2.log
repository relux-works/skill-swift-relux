private extension S2CDemo {
    static func resolveBootstrappedRelux() async -> Relux {
        let automation = S2CDemo.AutomationConfig.current
        await Registry.resolve((any S2CDemo.IRpcStubsConfigurator).self).configure(automation)

        let relux = await Registry.resolveAsync(Relux.self)
        let diagnostics = Registry.resolve((any Swipe2Cash.Diagnostics.External.ErrorHandler).self)

        await diagnostics.initialize()
        if Registry.resolve(S2CDemo.Diagnostics.RuntimeConfiguration.self).smokeTestEnabled {
            await relux.dispatcher.actions {
                Swipe2Cash.Effect.trackDiagnosticsSmokeTestError
            }
        }
        await relux.dispatcher.actions {
            S2CDemo.Auth.Effect.restoreSession
        }
        if automation.nearbyReceiverReclamation {
            await relux.dispatcher.actions {
                S2CDemo.AppRouter.Action.set([.swipe2Cash(.home)])
            }
            await relux.dispatcher.actions {
                Swipe2Cash.Action.selectTransferMode(.receive)
            }
        }

        return relux
    }
}
import ReluxAnalytics
import SwiftUI
import SwiftUIRelux

extension S2CDemo {
    struct Content: View {
        private let relux: Relux
        @State private var analyticsStarted = false

        init(relux: Relux) {
            self.relux = relux
        }

        var body: some View {
            S2CDemo.RootView(relux: relux)
                .task {
                    await startAnalyticsIfNeeded()
                }
        }
    }
}

private extension S2CDemo.Content {
    @MainActor
    func startAnalyticsIfNeeded() async {
        guard analyticsStarted == false else { return }
        analyticsStarted = true

        await relux.dispatcher.action {
            Analytics.Effect.start
        }
    }
}

